# ============================================================================
# FnB Digital - contoh variabel lingkungan. Salin menjadi .env lalu isi nilainya.
# File .env sudah di-.gitignore: JANGAN pernah di-commit.
# ============================================================================

# --- Database (PostgreSQL: Supabase / Neon / VPS) ---------------------------
# Supabase: Connect -> ORM -> Prisma.
# DATABASE_URL memakai transaction pooler (port 6543) + pgbouncer=true.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
# DIRECT_URL dipakai `prisma migrate deploy` (session pooler port 5432).
DIRECT_URL="postgresql://postgres.<ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# --- Aplikasi ---------------------------------------------------------------
# Domain publik, dipakai untuk URL QR meja dan tautan struk.
NEXT_PUBLIC_APP_URL="https://fnbtech.biz.id"
# Wajib 32+ karakter acak: `openssl rand -base64 48`
SESSION_SECRET=""
# Zona waktu operasional (opsional, default Asia/Jakarta).
RESTAURANT_TIMEZONE="Asia/Jakarta"

# --- Payment gateway (Midtrans) --------------------------------------------
# Tanpa MIDTRANS_SERVER_KEY, QRIS berjalan dalam mode demo.
PAYMENT_PROVIDER="midtrans"
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# HANYA untuk demo lokal. WAJIB "false" di server publik.
PAYMENT_ALLOW_UNSIGNED_WEBHOOK="false"
