# ============================================================================
# FnB Digital — contoh variabel lingkungan. Salin menjadi .env lalu isi nilainya.
# ============================================================================

# --- Database (PostgreSQL: Supabase / Neon / lokal) --------------------------
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fnb_digital?schema=public"
# Dipakai Prisma untuk koneksi pooling (opsional bila memakai Supabase/Neon).
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/fnb_digital?schema=public"

# --- Aplikasi ---------------------------------------------------------------
NEXT_PUBLIC_APP_URL="http://localhost:3000"
# Kunci penandatangan TableSessionToken (JWT) untuk sesi meja pelanggan.
SESSION_SECRET="ganti-dengan-string-acak-minimal-32-karakter"

# --- Payment Gateway (Midtrans / Xendit) ------------------------------------
PAYMENT_PROVIDER="midtrans"
MIDTRANS_MERCHANT_ID=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_SERVER_KEY=""
MIDTRANS_IS_PRODUCTION="false"

# Payload QRIS statis merchant (untuk generator QRIS lokal / mode demo).
# Kosongkan bila memakai QR dari gateway.
QRIS_STATIC_PAYLOAD=""

# HANYA untuk demo lokal: izinkan webhook pembayaran tanpa signature.
# JANGAN diaktifkan di produksi.
PAYMENT_ALLOW_UNSIGNED_WEBHOOK="false"

# --- Realtime (Supabase) ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
